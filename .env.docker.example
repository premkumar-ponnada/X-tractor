# Copy to .env (next to docker-compose.yml) and fill in. Never commit the real .env.

# Required
XT_AUTH_PASSWORD=choose-a-strong-password
XT_JWT_SECRET=generate-with-python -c "import secrets;print(secrets.token_urlsafe(48))"

# Optional
XT_AUTH_EMAIL=admin@xtractor.dev
XT_VERSION=1.0.0                 # image tag to build/push/pull
XT_REGISTRY=premponnada          # Docker Hub namespace
XT_WEB_PORT=8080
XT_PUBLIC_URL=http://localhost:8080
XT_WORKER_PROCESSES=1
# XT_APP_ENV=production          # then also XT_COOKIE_SECURE=true behind HTTPS
