# X-tractor backend settings. Copy to .env and adjust. All keys use the XT_ prefix.

XT_APP_ENV=local                      # local | production (production refuses unsafe values)
XT_LOG_LEVEL=INFO

# MongoDB (Azure: Cosmos DB for MongoDB connection string)
XT_MONGODB_URI=mongodb://localhost:27017
XT_MONGODB_DATABASE=xtractor

# Sign-in — single account for now (real user management comes later)
XT_AUTH_EMAIL=demo@xtractor.dev
XT_AUTH_PASSWORD=change-me
XT_JWT_SECRET=generate-a-random-value-of-at-least-32-characters
XT_JWT_TTL_MINUTES=480
XT_COOKIE_SECURE=false                # true behind HTTPS

# Frontend origin(s), comma-separated
XT_CORS_ORIGINS=http://localhost:5173

# Uploads
XT_MAX_FILE_MB=100
XT_MAX_FILES_PER_JOB=50

# Extraction services
XT_TIKA_URL=http://localhost:9998
XT_TESSERACT_CMD=tesseract
XT_OCR_LANGUAGES=swe+eng
XT_RUN_TIMEOUT_SECONDS=900

# Worker
XT_WORKER_PROCESSES=1                 # parallel extraction processes per worker
